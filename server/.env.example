# ============================================================
# MansaRent — API de paiement : variables d'environnement
# ============================================================
PORT=4000
# URL publique HTTPS de CE serveur (pour les webhooks). En local : utilisez ngrok.
PUBLIC_URL=http://localhost:4000
# URL du frontend (pour les redirections de retour)
APP_URL=http://localhost:5173
# Prix de l'abonnement (GNF)
SUBSCRIPTION_PRICE=50000

# ---- CinetPay (agrégateur : OM Guinée + MTN MoMo Guinée + Visa/Mastercard) ----
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_CURRENCY=GNF

# ---- Orange Money Web Payment (direct) ----
# OM_AUTH_BASIC = base64("consumer_key:consumer_secret") fourni par Orange Developer
OM_AUTH_BASIC=
OM_MERCHANT_KEY=
# Chemin pays de l'API : "dev" en sandbox ; valeur Guinée en production (selon Orange)
OM_WEBPAY_PATH=dev
# Devise : OUV en sandbox ; GNF en production
OM_CURRENCY=OUV

# ---- MTN MoMo (Collections) ----
# Sandbox : https://sandbox.momodeveloper.mtn.com ; production : hôte fourni par MTN
MOMO_BASE=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# "sandbox" puis votre marché en production
MOMO_TARGET_ENV=sandbox
# EUR en sandbox ; GNF en production
MOMO_CURRENCY=EUR

# ---- Hub2 (agrégateur PayIn) ----
HUB2_API_KEY=
HUB2_MERCHANT_ID=
HUB2_ENV=sandbox
HUB2_COUNTRY=GN
HUB2_CURRENCY=GNF
